# Production-oriented template (same variable contract as `.env.example`).
# Copy values from your secrets manager / host env; never commit real secrets.
# Validated by `npm run check:env` alongside `.env.example`.

# --- Required (Supabase RAG + analysis cache) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional AI providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional RAG tuning ---
# RAG_MAX_KB_CHUNKS=
# RAG_MIN_KB_SIMILARITY=
# RAG_MAX_PAST_ANALYSES=
# RAG_MIN_ANALYSIS_SIMILARITY=
# RAG_MAX_KB_CHARS_PER_CHUNK=
# RAG_MAX_KB_CONTEXT_CHARS=
# RAG_MAX_FEW_SHOT_CHARS=

# --- Optional provenance strings ---
# LINGUBREAK_PROMPT_VERSION=
# KB_INGEST_VERSION=
