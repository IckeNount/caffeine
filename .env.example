# Copy to `.env.local` for development. Required keys are validated by `src/env/schema.ts`
# (`npm run check:env` in CI). Production template: `.env.production.example` (same keys).

# --- Required (Supabase RAG + analysis cache) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Required demo providers ---
# OpenRouter: daily reading generation + RAG embeddings
OPENROUTER_API_KEY=
# Gemini Developer API: sentence analysis (Gemini 3.6 Flash free tier)
GEMINI_API_KEY=

# --- Optional cloud OCR (local Tesseract remains the learner default) ---
OCR_CLOUD_ENABLED=false
GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Optional dormant direct-provider adapters ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional RAG tuning (`src/config/rag.ts`) ---
# RAG_MAX_KB_CHUNKS=
# RAG_MIN_KB_SIMILARITY=
# RAG_MAX_PAST_ANALYSES=
# RAG_MIN_ANALYSIS_SIMILARITY=
# RAG_MAX_KB_CHARS_PER_CHUNK=
# RAG_MAX_KB_CONTEXT_CHARS=
# RAG_MAX_FEW_SHOT_CHARS=

# --- Optional provenance strings ---
# LINGUBREAK_PROMPT_VERSION=
# KB_INGEST_VERSION=
